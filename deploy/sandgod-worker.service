[Unit]
Description=启灵沙盘天梯评测服务
After=network-online.target

[Service]
WorkingDirectory=/home/irade/github/sandGod
EnvironmentFile=-/home/irade/.config/agent-control/keys.env
Environment=SANDGOD_ENABLE_SOURCE_EVAL=1
Environment=SANDGOD_ARTIFACT_DIR=/home/irade/.local/share/sandgod/strategies
Environment=SANDGOD_LOCAL_MODEL_APP=/home/irade/sandGod/typescript-app
ExecStart=/usr/bin/node /home/irade/github/sandGod/deploy/service.cjs worker
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=16min
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
